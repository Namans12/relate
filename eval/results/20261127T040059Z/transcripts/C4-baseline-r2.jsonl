log, including an advance.\n\nThe test `scripts/tests/test_release_advance.sh` guards this rule. It runs the bump with `--skip-changelog` on an empty-`[Unreleased]` changelog and expects the file to stay byte-identical. With the guard gone, rotation would run and insert a heading, so I expect the test to fail. I didn't run it, so I've marked the outcome as unknown.\n\n{\"verdict\": \"violates\", \"decisions\": [\"ADR-0580\"], \"checks\": [\"advance: empty-[Unreleased] CHANGELOG.md byte-identical — no heading inserted, [Unreleased] ref unchanged\"], \"check_outcomes\": {\"advance: empty-[Unreleased] CHANGELOG.md byte-identical — no heading inserted, [Unreleased] ref unchanged\": \"unknown\"}}", "ttft_ms": 2372, "type": "result", "duration_ms": 11781, "uuid": "8e09be01-744d-4f14-8b53-2177c7bfbd83", "ttft_stream_ms": 1945, "time_to_request_ms": 486, "time_to_request_phases_ms": {"other": 70, "system_prompt": 13, "resume_other": 0, "process_user_input": 1, "input_attachments": 2, "input_hooks": 0, "tool_pool_refresh": 1, "init_message": 2, "engine_pickup": 0, "message_prep": 0, "model_config_wait": 1, "autocompact": 0, "query_setup": 0, "model_gates": 390, "tool_schema_build": 2, "message_normalization": 0, "client_creation": 2, "request_build": 2}, "turn_start_resume_kind": "none", "process_turn_index": 0, "time_to_request_loop_lag_ms": 28, "time_to_request_cpu_ms": 306, "time_to_request_major_faults": 0, "input_attachments_detail": {"slowest_producer": "queued_commands", "slowest_producer_ms": 1, "cpu_ms": 2, "major_faults": 0}, "first_content_frame_ms": 1946, "queued_turn_count": 0, "result_index": 0}}

{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% set nav_active = "scenarios" %}
{% block title %}{{ patch.label }} - Patch Precedent{% endblock %}
{% block body_class %}patch{% endblock %}
{% block main %}
{% set pg = c["patch_page"] %}
{% set v = patch.verdict %}
{% set kind = {"violates": "fail", "consistent": "pass"}.get(v.kind, "none") %}
{% set n_checks = patch.decisions | map(attribute="checks") | map("length") | sum %}
{% set adr = v.decisions | join(", ") %}
{% set badge_text = {"violates": "violates " ~ adr, "consistent": "consistent with " ~ adr}.get(v.kind, "no linked decision") %}
{% set failing = patch.failing_numbers %}
{% set prev = (data.patches | selectattr("slug", "equalto", patch.prev_slug) | list | first) if patch.prev_slug else none %}
{% set nxt = (data.patches | selectattr("slug", "equalto", patch.next_slug) | list | first) if patch.next_slug else none %}

<div class="wrap layout">
  <aside class="side" aria-label="Patches">
    {% for scenario, group in data.patches | groupby("scenario") %}
    {% set ids = group | selectattr("verdict.decisions") | map(attribute="verdict.decisions") | map("first") | list %}
    <div class="group">
      <div class="gtitle">{{ group[0].scenario_title }}{% if ids %} <span>{{ ids[0] }}</span>{% endif %}</div>
      {% for q in group %}
      {% set qk = {"violates": "fail", "consistent": "pass"}.get(q.verdict.kind, "none") %}
      <a class="item{% if q.slug == patch.slug %} on{% endif %}" href="{{ ('scenarios/' ~ q.slug ~ '.html') | rel }}"{% if q.slug == patch.slug %} aria-current="page"{% endif %}><span>{{ q.label }}</span><i class="dot d-{{ qk }}" role="img" aria-label="{{ {'fail': 'violates', 'pass': 'consistent', 'none': 'no linked decision'}[qk] }}"></i></a>
      {% endfor %}
    </div>
    {% endfor %}
  </aside>

  <div class="stack">
    <header class="reveal phead">
      <div class="eyebrow">{{ patch.scenario_title }} · {% if adr %}{{ adr }}{% else %}no linked decision{% endif %}</div>
      <div class="ptitle"><h1>{{ patch.label }}</h1>{{ m.badge(kind, badge_text) }}</div>
      <p class="muted lede-sm">{{ patch.summary }}</p>
    </header>

    <div class="stats reveal">
      {{ m.stat("Harness", patch.passed ~ " / " ~ patch.failed) }}
      {{ m.stat("Exit code", patch.exit_code) }}
      {{ m.stat("Linked checks", n_checks) }}
      <div class="stat"><small>Failing</small>{% if failing %}<b class="n-fail">{% for n in failing %}{% if not loop.first %}, {% endif %}#{{ n }}{% endfor %}</b>{% else %}<b class="n-none">none</b>{% endif %}</div>
    </div>

    <section class="verdict callout-{{ kind }} reveal" aria-labelledby="callout-h">
      <div class="ico" aria-hidden="true">{{ {"fail": "!", "pass": "✓", "none": "i"}[kind] }}</div>
      <div><h3 id="callout-h">{{ patch.heading }}</h3><p class="muted">{{ patch.body }}</p></div>
    </section>

    {% for f in patch.diff %}
    <div class="code reveal">
      <div class="code-bar"><span class="path">{{ f.path }}</span><span class="delta"><b class="pl">+{{ f.added }}</b> <b class="mi">-{{ f.removed }}</b></span></div>
      <pre data-verbatim tabindex="0" aria-label="Diff of {{ f.path }}">{% for ln in f.lines %}{% if ln.kind == "hunk" %}<div class="ln hunk"><span class="n"></span><span></span><span>{{ ln.text }}</span></div>{% else %}<div class="ln {{ ln.kind }}"><span class="n">{{ ln.new if ln.new is not none else ln.old }}</span><span class="s">{{ {"add": "+", "del": "-"}.get(ln.kind, "") }}</span><span>{{ ln.text | replace("\t", "    ") }}</span></div>{% endif %}{% endfor %}</pre>
    </div>
    {% endfor %}

    {% for d in patch.decisions %}
    <section class="card reveal">
      <div class="card-head"><span class="label">Decision</span><span class="pill">{{ d.status | prose }}</span></div>
      <h3>{{ d.id }} · {{ d.title | prose }}</h3>
      <p class="rule"><b>Rule.</b> {{ d.rule }}</p>
      <p class="muted">{{ d.reason }}</p>
      <div class="links-row">
        <a class="lnk" href="{{ d.decision_url }}" target="_blank" rel="noopener">Decision</a>
        <a class="lnk" href="{{ d.consequences_url }}" target="_blank" rel="noopener">Scope</a>
        <a class="lnk" href="{{ d.citation_url }}" target="_blank" rel="noopener">Citation in {{ patch.diff[0].path.rsplit("/", 1)[-1] }}</a>
        <a class="lnk" href="{{ d.commit_url }}" target="_blank" rel="noopener">Commit {{ d.commit_sha[:8] }}</a>
      </div>
    </section>
    {% else %}
    <section class="card reveal">
      <div class="card-head"><span class="label">Decision</span><span class="pill">none</span></div>
      <h3><code class="mono">{{ patch.diff[0].path }}</code> cites no decision</h3>
      <p class="muted">{{ patch.body.partition(". ")[2] }}</p>
    </section>
    {% endfor %}

    {% if n_checks %}
    <section class="card reveal">
      <div class="card-head"><span class="label">Checks guarding this decision</span><span class="muted note">observed in the replay</span></div>
      <div class="twrap"><table class="t">
        <thead><tr><th scope="col">Check</th><th scope="col" class="hide-sm">Kind</th><th scope="col">What it asserts</th><th scope="col">Result</th></tr></thead>
        <tbody>
        {% for d in patch.decisions %}{% for k in d.checks %}
          <tr>
            <td class="k"><a class="src" href="{{ k.url }}" target="_blank" rel="noopener">#{{ k.number }}</a></td>
            <td class="hide-sm"><span class="pill">{{ k.kind }}</span></td>
            <td class="what">{{ k.short }}<code class="full" data-verbatim>{{ k.name }}</code></td>
            <td>{{ m.badge({"ok": "pass", "not ok": "fail"}.get(k.observed, "none"), k.observed) }}</td>
          </tr>
        {% endfor %}{% endfor %}
        </tbody>
      </table></div>
    </section>
    {% endif %}

    <section class="card reveal">
      <div class="card-head"><span class="label">Graph</span>
        <div class="legend"><span><i style="background:#1B1F2A"></i>patch</span><span><i style="background:#E36B47"></i>decision</span><span><i style="background:#2F7D57"></i>check ok</span><span><i style="background:#B4472A"></i>check not ok</span><span><i style="background:#D9D1C2"></i>scanned</span></div>
      </div>
      <div class="graph-scroll">{{ graph_svg(patch) | safe }}</div>
      <p class="caption">{{ pg["graph_caption"] }}</p>
    </section>

    {% if patch.also_cites %}
    <details class="card more reveal">
      <summary><span>Also cited by {{ patch.diff[0].path.rsplit("/", 1)[-1] }}</span><span class="muted note">{{ patch.also_cites | length }} ADRs, scanned from source, not reviewed</span></summary>
      <ul class="cited">
        {% for a in patch.also_cites %}
        <li><a class="mono" href="{{ a.url }}" target="_blank" rel="noopener">{{ a.id }}</a><span>{{ a.title }}</span><span class="pill">{{ a.status }}</span></li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}

    <details class="card more reveal">
      <summary><span>Query it yourself</span></summary>
      <div class="queries">
        {% for title, q in patch.queries %}
        <div class="code cmd">
          <div class="code-bar"><span>{{ title }}</span><button class="copy" type="button" data-copy aria-label="Copy query: {{ title }}">Copy</button></div>
          <pre data-verbatim tabindex="0">{{ q | text }}</pre>
        </div>
        {% endfor %}
        <p class="muted note">{{ pg["query_note"] }}</p>
      </div>
    </details>

    <div class="reveal">
      <h2 class="h-sm">Inspect it yourself</h2>
      {{ m.copy_block(patch.explain_cmd) }}
    </div>

    <nav class="pager reveal" aria-label="Patches">
      {% if prev %}<a class="prev" href="{{ ('scenarios/' ~ prev.slug ~ '.html') | rel }}"><small>Previous</small><b>{{ prev.label }}</b></a>{% else %}<span></span>{% endif %}
      {% if nxt %}<a class="next" href="{{ ('scenarios/' ~ nxt.slug ~ '.html') | rel }}"><small>Next</small><b>{{ nxt.label }}</b></a>{% else %}<span></span>{% endif %}
    </nav>
  </div>
</div>
{% endblock %}

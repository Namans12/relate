{% macro play_icon() -%}
<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false" fill="currentColor"><path d="M2 1.2v7.6a.5.5 0 0 0 .76.43l6.1-3.8a.5.5 0 0 0 0-.86l-6.1-3.8A.5.5 0 0 0 2 1.2z"/></svg>
{%- endmacro %}

{% macro copy_block(cmd, label="terminal") -%}
<div class="code cmd">
  <div class="code-bar"><span>{{ label }}</span><button class="copy" type="button" data-copy aria-label="Copy {{ label }}">Copy</button></div>
  <pre data-verbatim>{{ cmd }}</pre>
</div>
{%- endmacro %}

{% macro badge(kind, text) -%}
<span class="badge b-{{ kind }}">{{ text }}</span>
{%- endmacro %}

{% macro stat(label, value) -%}
<div class="stat"><small>{{ label }}</small><b>{{ value }}</b></div>
{%- endmacro %}

{% macro check_dot(observed) -%}
{%- set kind = {"ok": "pass", "not ok": "fail"}.get(observed, "none") -%}
<span class="dot d-{{ kind }}" role="img" aria-label="{{ observed }}"></span>
{%- endmacro %}

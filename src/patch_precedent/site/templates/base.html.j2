{%- import "macros.html.j2" as m -%}
{%- set na = nav_active | default("") -%}
<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Patch Precedent{% endblock %}</title>
<script>document.documentElement.className = 'js';</script>
<link rel="icon" href="{{ 'assets/favicon.svg' | rel }}" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'assets/site.css' | rel }}">
{% include "_og.html.j2" %}
{% block head_extra %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
<a class="skip" href="#main">Skip to content</a>
{%- set links = [
  ("overview", "Overview", "home.html"),
  ("scenarios", "Scenarios", "home.html#scenarios"),
  ("results", "Results", "results.html"),
  ("use", "Use it", "use.html"),
  ("relate", "Relate", "relate.html"),
] %}
<header class="nav">
  <div class="wrap">
    <a class="brand" href="{{ 'home.html' | rel }}" aria-label="Patch Precedent, overview">
      <svg width="28" height="28" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <rect width="100" height="100" rx="22" fill="#1B1F2A"/>
        <g stroke="#FAF7F2" stroke-width="3.4" stroke-linecap="round"><path d="M42 44 33 36"/><path d="M60 44 70 34"/><path d="M42 63 32 71"/></g>
        <rect x="14" y="16" width="22" height="26" rx="4" fill="#FAF7F2"/>
        <path d="M19 25h8M19 31h12" stroke="#1B1F2A" stroke-width="3" stroke-linecap="round"/>
        <circle cx="51" cy="54" r="14.5" fill="#1B1F2A" stroke="#E36B47" stroke-width="7"/>
        <circle cx="76" cy="28" r="8" fill="#FAF7F2"/><path d="m72.4 28.2 2.4 2.4 4.4-4.8" fill="none" stroke="#1B1F2A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="26" cy="77" r="8" fill="#FAF7F2"/><path d="m22.4 77.2 2.4 2.4 4.4-4.8" fill="none" stroke="#1B1F2A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Patch Precedent</span>
    </a>
    <nav class="links" aria-label="Primary">
      {%- for id, label, href in links %}
      <a href="{{ href | rel }}"{% if id == na %} class="on" aria-current="page"{% endif %}>{{ label }}</a>
      {%- endfor %}
    </nav>
    <div class="nav-cta">
      <a class="icon-btn gh" href="https://github.com/Namans12/relate" target="_blank" rel="noopener" aria-label="Patch Precedent on GitHub">{{ m.gh_icon() }}</a>
      <a class="btn btn-primary" href="{{ 'home.html#demo' | rel }}"><span class="play-dot">{{ m.play_icon() }}</span>Run the demo</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu-panel">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 5h12M3 9h12M3 13h12"/></svg>
      </button>
    </div>
  </div>
  <div class="menu-panel" id="menu-panel" hidden>
    <div class="wrap">
      {%- for id, label, href in links %}
      <a href="{{ href | rel }}"{% if id == na %} class="on" aria-current="page"{% endif %}>{{ label }}</a>
      {%- endfor %}
      <a href="{{ 'home.html#demo' | rel }}">Run the demo</a>
      <a href="https://github.com/Namans12/relate" target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer class="foot">
  <div class="wrap">
    <span>Patch Precedent · MIT</span>
    <span class="foot-links"><a class="gh-link" href="https://github.com/Namans12/relate" target="_blank" rel="noopener">{{ m.gh_icon(16) }}GitHub</a></span>
    <span>Relate is a product of Neo4j. Not affiliated.</span>
  </div>
</footer>
<div class="sr-only" aria-live="polite" id="sr-status"></div>
<script src="{{ 'assets/site.js' | rel }}" defer></script>
<script>
// If site.js did not run (blocked or failed to load), reveal everything rather than leave it hidden.
setTimeout(function () {
  if ('siteReady' in document.documentElement.dataset) return;
  document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
}, 2000);
</script>
</body>
</html>
